# Required. Never commit the populated .env file.
OPENROUTER_API_KEY=
INTERNAL_REVIEW_API_KEY=

# Optional public detector API key. Keep both services bound to localhost unless
# a TLS/rate-limiting reverse proxy is configured.
PPD_API_KEY=
PPD_HOST_PORT=8088
REVIEW_HOST_PORT=8090

# Sibling source checkout used by the build-enabled Compose stack.
AGENT_REVIEW_CONTEXT=../../agentic-phishing-review

OPENROUTER_MODEL=google/gemma-4-31b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=PersianPhish Integrated Review

PPD_AGENT_TIMEOUT_S=75
PPD_AGENT_POLL_INTERVAL_S=0.25
REVIEW_WORKER_CONCURRENCY=2
REVIEW_RETENTION_DAYS=30
