{
  "schema_version": 1,
  "stack_version": "1.1.0",
  "components": {
    "extension": {
      "repository": "https://github.com/VibeATSCoder/phishingshield-persian",
      "version": "3.8.3",
      "tag": "v3.8.3"
    },
    "detector": {
      "repository": "https://github.com/VibeATSCoder/phishing-detection-engine",
      "version": "3.8.3",
      "tag": "v3.8.3"
    },
    "reviewer": {
      "repository": "https://github.com/VibeATSCoder/agentic-phishing-review",
      "version": "1.11.0",
      "tag": "v1.11.0"
    },
    "rag": {
      "repository": "https://github.com/VibeATSCoder/phishing-rag-service",
      "version": "2.1.0",
      "optional": true,
      "tag": "v2.1.0"
    }
  },
  "contracts": {
    "extension_to_detector": "POST /v1/detect",
    "detector_to_reviewer": "POST /api/v1/analyses",
    "verdicts": [
      "legitimate",
      "phishing",
      "suspicious",
      "crawl_failed"
    ],
    "reviewer_to_rag": "POST /v1/references"
  }
}
