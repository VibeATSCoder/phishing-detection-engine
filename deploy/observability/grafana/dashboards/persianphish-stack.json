{
  "uid": "persianphish-stack",
  "title": "PersianPhish Stack",
  "tags": [
    "persianphish",
    "security"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Verdict flow",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Detections per second by verdict",
      "description": "The shape of this chart is the system's posture. A healthy stack shows a legitimate/phishing majority with a steady minority of suspicious and a low crawl_failed floor.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 18,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "legitimate"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "phishing"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "suspicious"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "crawl_failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (verdict) (rate(ppd_detections_total[5m]))",
          "legendFormat": "{{verdict}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Deciding stage",
      "description": "Which stage resolved each detection. A large 'reputation' slice means the intel feed is doing the work; a large 'agent' slice means escalation is expensive.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum by (stage) (increase(ppd_detections_total[$__range]))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Abstention rate",
      "description": "Share of traffic answered as suspicious or crawl_failed. By design this is never zero.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(ppd_detections_total{verdict=~\"suspicious|crawl_failed\"}[$__rate_interval])) / clamp_min(sum(rate(ppd_detections_total[$__rate_interval])), 0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Latency and escalation",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Detection latency percentiles",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ppd_detection_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ppd_detection_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ppd_detection_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Time spent per stage (p95)",
      "description": "Crawl, domain facts, and agent wait. The agent series is the dominant cost whenever escalation is active.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (stage, le) (rate(ppd_stage_duration_seconds_bucket[5m])))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Agent escalations by outcome",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 18,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(ppd_agent_calls_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "How the agent's advice was reconciled",
      "description": "The reviewer is advisory. 'corroborated=false' means the detector declined to act on its verdict and kept the case suspicious.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "expr": "sum by (agent_verdict, corroborated) (rate(ppd_agent_reconciliation_total[15m]))",
          "legendFormat": "{{agent_verdict}} / corroborated={{corroborated}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Model health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "collapsed": false
    },
    {
      "type": "heatmap",
      "title": "Combined score distribution",
      "description": "Watch for the mass shifting between releases. A drift here precedes a change in verdict mix.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "expr": "sum by (le) (rate(ppd_model_score_bucket{model=\"combined\"}[10m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Out-of-distribution fraction",
      "description": "Rising OOD means inputs no longer resemble the calibration set, and the policy gate is abstaining more often as a result.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 26
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ppd_ood_fraction_bucket[10m])) by (le))",
          "legendFormat": "median",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(ppd_ood_fraction_bucket[10m])) by (le))",
          "legendFormat": "p90",
          "refId": "B"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Review queue depth",
      "description": "Nothing drains this automatically; it is worked by a human.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 250
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "ppd_review_queue_depth",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Agentic reviewer",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Analyst vs verifier agreement",
      "description": "The skeptical second pass exists to override an over-eager analyst. If every series here is an agreement, the verifier has stopped adding value.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "expr": "sum by (analyst, verifier, final) (increase(apr_agreement_total[$__range]))",
          "legendFormat": "{{analyst}} → {{verifier}} ⇒ {{final}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "OpenRouter token usage per pass (p95)",
      "description": "Drives cost. A step change usually means a prompt or evidence packet grew.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 35
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (pass, direction, le) (rate(apr_llm_tokens_bucket[15m])))",
          "legendFormat": "{{pass}} {{direction}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM call outcomes",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 35
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(apr_llm_calls_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LangGraph node latency (p95)",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (node, le) (rate(apr_node_duration_seconds_bucket[10m])))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Intelligence monitor",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "CT discovery funnel",
      "description": "Hostnames observed versus retained by the keyword gate. The gap is intentional and large.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 51
      },
      "targets": [
        {
          "expr": "sum(rate(pim_hostnames_observed_total[10m]))",
          "legendFormat": "observed",
          "refId": "A"
        },
        {
          "expr": "sum(rate(pim_keyword_matches_total[10m]))",
          "legendFormat": "kept",
          "refId": "B"
        },
        {
          "expr": "sum(rate(pim_certstream_messages_total[10m]))",
          "legendFormat": "CT messages",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Candidates by state",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 51
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 18,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "expr": "pim_candidates",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Adjudication backlog",
      "description": "Age of the longest-waiting due candidate. Rising means discovery is outpacing VirusTotal checks.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 51
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 86400
              },
              {
                "color": "red",
                "value": 172800
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "pim_oldest_due_candidate_age_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "VirusTotal checks by outcome",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 59
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(pim_vt_checks_recorded_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "VT requests used today",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 59
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 400
              },
              {
                "color": "red",
                "value": 480
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "pim_vt_requests_today",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Running versions",
      "description": "artifact_production_ready reflects the loaded artifact's own self-assessment.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 59
      },
      "targets": [
        {
          "expr": "ppd_build_info",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "apr_build_info",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "pim_build_info",
          "format": "table",
          "instant": true,
          "refId": "C"
        }
      ]
    },
    {
      "type": "row",
      "title": "Reference retrieval",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 66
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Reference lookups by outcome",
      "description": "An empty result is a legitimate answer. A sustained majority of them means the index no longer covers the traffic.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 67
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(rag_lookups_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Top reference score",
      "description": "The reviewer needs reference_quality >= 0.6 to escape the suspicious floor, and quality is bounded above by this.",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 67
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(rag_top_reference_score_bucket[15m])) by (le))",
          "legendFormat": "median",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9, sum(rate(rag_top_reference_score_bucket[15m])) by (le))",
          "legendFormat": "p90",
          "refId": "B"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Index size",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 67
      },
      "targets": [
        {
          "expr": "rag_index_blocks",
          "legendFormat": "blocks",
          "refId": "A"
        },
        {
          "expr": "rag_index_pages",
          "legendFormat": "pages",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reference lookup latency (p95)",
      "description": "The reviewer blocks on this. Dense search is brute force over the whole block matrix.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 74
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_lookup_duration_seconds_bucket[10m])) by (le))",
          "legendFormat": "lookup p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(rag_encode_duration_seconds_bucket[10m])) by (le))",
          "legendFormat": "encode p95",
          "refId": "B"
        }
      ]
    }
  ]
}