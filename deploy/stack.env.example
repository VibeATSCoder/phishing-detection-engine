# Aggregated configuration for the whole stack: detector, reviewer, and the
# optional reference retrieval service. One file, one place to edit.
#
#   cp stack.env.example .env
#
# Only the first two values must be filled in. Everything else has a working
# default and is here so you can see what exists without reading three repos.

# ---------------------------------------------------------------- required --
# Your OpenRouter key. The reviewer cannot start without it.
OPENROUTER_API_KEY=

# Any string you invent. It authenticates the detector to the reviewer over the
# internal network; nothing outside the stack ever sees it.
INTERNAL_REVIEW_API_KEY=

# ------------------------------------------------------------------ ports ---
# Host interface the ports bind to.
#   127.0.0.1 (default)  reachable only from this machine. Safe.
#   0.0.0.0              reachable from any network the host is on.
#   10.0.0.5             a specific interface, if you want just one.
# Only the detector is meant to face the outside; the reviewer and RAG stay on
# loopback regardless of this (see the reviewer/RAG notes in compose files).
# BEFORE you set this to 0.0.0.0, set PPD_API_KEY below — an open detector with
# no key lets anyone on the network drive it, and every URL it inspects spends
# OpenRouter budget. In production the right posture is still loopback + a TLS
# reverse proxy with auth in front; 0.0.0.0 is for a quick remote check or a
# trusted private network.
BIND_HOST=127.0.0.1
# Host port the detector is published on. Set it to 80 to serve on the standard
# HTTP port (http://host/ with no :port), e.g. when only port 80 is open inbound
# to the server. The container still listens on 8088 internally; this only maps
# the host side. 80 needs no extra privilege — the Docker daemon binds it.
PPD_HOST_PORT=8088
REVIEW_HOST_PORT=8090
RAG_HOST_PORT=8092
# The reviewer and RAG have their own bind, defaulting to loopback and NOT
# following BIND_HOST, so exposing the detector never exposes them. Uncomment to
# reach them directly (rarely needed); set INTERNAL_REVIEW_API_KEY / RAG_API_KEY.
# REVIEW_BIND_HOST=127.0.0.1
# RAG_BIND_HOST=127.0.0.1

# --------------------------------------------------------------- detector ---
# Optional API key for the detector's own endpoint. Empty means unauthenticated,
# which is fine on loopback but NOT once BIND_HOST exposes it on a network.
# When set, callers send it as the X-API-Key header; the Swagger UI (/docs) and
# the schema (/openapi.json) stay open so you can still read the API.
PPD_API_KEY=
PPD_AGENT_TIMEOUT_S=75
PPD_AGENT_POLL_INTERVAL_S=0.25

# --------------------------------------------------------------- reviewer ---
OPENROUTER_MODEL=google/gemma-4-31b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=PersianPhish Integrated Review
REVIEW_WORKER_CONCURRENCY=2
REVIEW_RETENTION_DAYS=30

# ---------------------------------------------- reference retrieval (opt) ---
# Only used with --with-references.
#
# The index is a multi-gigabyte directory mounted from this host, not baked into
# the image. Point this at your Embedding_Index directory.
RAG_INDEX_HOST_PATH=

# Follows whichever image you loaded. Change it only if you loaded a different
# version than the stack contract records.
RAG_VERSION=2.1.0
# The index is data, versioned independently of the service image: the 2.0.0
# index works unchanged with the 2.1.0 service.
RAG_INDEX_VERSION=2.0.0
# Query embedding backend:
#   local (default)  loads bge-m3 in the RAG container (~2.8 GB RAM)
#   api              delegates embedding to an OpenAI-compatible endpoint. Drops
#                    the 2.2 GB bge-m3 model, leaving ~1.5 GB (the ~1 GB memory-
#                    mapped index plus runtime), so RAG_MEM_LIMIT can go to ~3-4g.
#                    The endpoint MUST serve the same model the index was built
#                    with (BAAI/bge-m3, 1024-dim); the retriever verifies the
#                    returned dimension and refuses a mismatch.
RAG_EMBED_MODE=local
RAG_EMBED_API_BASE=
RAG_EMBED_API_KEY=
RAG_EMBED_MODEL=
RAG_EMBED_TIMEOUT_S=15
RAG_API_KEY=
# Retrieval measured 0.35-1.8s idle and up to 18s under heavy CPU contention, so
# this is a ceiling for a bad moment rather than a typical cost. A timeout
# yields no references and the review continues, floored at suspicious.
RAG_TIMEOUT_S=15
RAG_TOP_K=3
# The index is memory-mapped and counts against this. Measured: 4g made every
# lookup take longer than the reviewer's timeout and return nothing, 8g lands at
# 5-7s, 12g at 2.6-4.7s.
RAG_MEM_LIMIT=8g
RAG_CPUS=2.0

# ------------------------------------------------------------ build-only ---
# Sibling source checkout, used only by the build-from-source Compose file.
# Irrelevant when running from released images.
AGENT_REVIEW_CONTEXT=../../agentic-phishing-review
